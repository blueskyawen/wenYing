<template>
	<view class="note-square">
		<mescroll-body class="body-content" @init="mescrollInit" @down="downCallback" @up="upCallback">
			 <view class="note-list">
				 <view class="note-list-left">
					 <view class="note-item-box" v-for="(item, index) in listLeft" :key="index">
						 <view class="note-item" @tap="goDetail(item)">
							 <view class="note-img">
								 <image :src="item.cover_src"></image>
							 </view>
							 <view class="note-title">{{ item.content }}</view>
							 <view class="note-date">
								 <view class="note-autor">
									{{ item.user_id && item.user_id.length ?  item.user_id[0].nickname : '游客'}}
								 </view>
								 <view class="publish-date">
									 <uni-dateformat :date="item.publish_date" format="yyyy-MM-dd"></uni-dateformat>
								 </view>
							 </view>
						 </view>
					 </view>
				 </view>
				 <view class="note-list-left">
					 <view class="note-item-box" v-for="(item2, index) in listRight" :key="index">
						 <view class="note-item" @tap="goDetail(item2)">
							 <view class="note-img">
								 <image :src="item2.cover_src"></image>
							 </view>
							 <view class="note-title">{{ item2.content }}</view>
							 <view class="note-date">
								 <view class="note-autor">
									{{ item2.user_id && item2.user_id.length ?  item2.user_id[0].nickname : '游客'}}
								 </view>
								 <view class="publish-date">
									 <uni-dateformat :date="item2.publish_date" format="yyyy-MM-dd"></uni-dateformat>
								 </view>
							 </view>
						 </view>
					 </view>
				 </view>
			 </view>
		</mescroll-body>
	</view>
</template>

<script>
	import MescrollMixin from "@/uni_modules/mescroll-uni/components/mescroll-uni/mescroll-mixins.js";
	import parseImageUrl from "@/common/parseImageUrl.js"
	const cmsNoteDB = uniCloud.importObject('cms-note-co');
	export default {
		mixins: [MescrollMixin],
		data() {
			return {
				list: []
			}
		},
		computed: {
			listLeft() {
				return this.list.filter((x, index) => index % 2 == 0)
			},
			listRight() {
				return this.list.filter((x, index) => index % 2 !== 0)
			}
		},
		methods: {
			async upCallback(page) {
				let pageNum = page.num; // 页码, 默认从1开始
				let pageSize = page.size; // 页长, 默认每页10条
				try {
					let res = await cmsNoteDB.getSearch(pageNum, pageSize);
					let curPageData = res.data || [];
					let images = curPageData.map(x => x.cover);
					let resImgs = await parseImageUrl(images);
					curPageData.forEach(x => {
						let img = resImgs.find(y => y.source == x.cover)
						if (img) {
							x.cover_src = img.src;
						}
					});
					if(pageNum == 1) this.list = [];
					this.list = this.list.concat(curPageData);
					this.mescroll.endSuccess(curPageData.length);
					console.log(this.list)
				} catch(err) {
					this.mescroll.endErr()
				}
			},
			reloadList(){
				/*若希望重新加载列表,只需调用此方法即可(内部会自动page.num=1,再主动触发up.callback)*/
				this.mescroll.resetUpScroll();
			},
			goDetail(item) {
				uni.navigateTo({
					url: '/pages/note/noteView/noteView?id=' + item._id
				})
			},
		}
	}
</script>

<style lang="scss" scoped>
	.body-content ::v-deep {
		.mescroll-empty {
			align-items: center;
		}
		.downwarp-content {
			align-items: center;
		}
		.mescroll-upwarp > view {
			align-items: center;
		}
	}
.note-square {
	background-color: #f1f3f7;
	.note-list {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		.note-list-left {
			width: 50%;
		}
		.note-item-box {
			background: #fff;
			box-shadow: 0 0 5px rgba($color: #8f939c, $alpha: 0.5);
			margin: 4px;
			box-sizing: border-box;
			.note-item {
				.note-img {
					image {
						width: 100%;
						height: 180px;
					}
				}
				.note-title {
					margin: 12px;
					box-sizing: border-box;
					line-height: 1.4em;
				  display: -webkit-box;
				  -webkit-line-clamp: 3;    /* 限制显示行数 */
				  -webkit-box-orient: vertical;
				  overflow: hidden;
				}
				.note-date {
					display: flex;
					flex-direction: column;
					font-size: 14px;
					margin: 10px 6px;
					.note-autor {}
					.publish-date {
						color: #8f939c;
						margin-top: 6px;
					}
				}
			}
		}
	}
}
</style>
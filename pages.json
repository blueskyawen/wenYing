{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue",
			"^uni-icons$": "@/uni_modules/uni-icons/components/uni-icons/uni-icons.vue",
			"^uni-list$": "@/uni_modules/uni-list/components/uni-list/uni-list.vue",
			"^uni-list-item$": "@/uni_modules/uni-list/components/uni-list-item/uni-list-item.vue",
			"^uni-forms$": "@/uni_modules/uni-forms/components/uni-forms/uni-forms.vue",
			"^uni-forms-item$": "@/uni_modules/uni-forms/components/uni-forms-item/uni-forms-item.vue",
			"^uni-grid$": "@/uni_modules/uni-grid/components/uni-grid/uni-grid.vue",
			"^uni-grid-item$": "@/uni_modules/uni-grid/components/uni-grid-item/uni-grid-item.vue",
			"^uni-load-state$": "@/uni_modules/uni-cms-article/components/uni-load-state/uni-load-state.vue",
			"^uni-sign-in$": "@/uni_modules/uni-sign-in/components/uni-sign-in/uni-sign-in.vue",
			"^uni-popup-captcha$": "@/uni_modules/uni-captcha/components/uni-popup-captcha/uni-popup-captcha.vue",
			"^uni-popup-dialog$": "@/uni_modules/uni-popup/components/uni-popup-dialog/uni-popup-dialog.vue",
			"^uni-id-pages-(.*)": "@/uni_modules/uni-id-pages/components/uni-id-pages-$1/uni-id-pages-$1.vue"
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			// #ifndef MP-WEIXIN
				"path": "uni_modules/uni-cms-article/pages/list/list",
			// #endif
			// #ifdef MP-WEIXIN
				"path": "pages/tabbars/article/list",
			// #endif
			"style": {
				"backgroundColor": "#FFFFFF",
				// #ifndef MP-WEIXIN
				 "disableScroll": true,
				// #endif
				// #ifndef APP || MP-WEIXIN
					"enablePullDownRefresh": true,
				// #endif
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/tabbars/ucenter/ucenter",
			"style": {
				"navigationBarTitleText": "",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/tabbars/video/video",
			"style": {
				"navigationBarTitleText": "",
				"navigationStyle": "custom"
			}
		},
		// #ifdef APP
		{
			"path": "uni_modules/uni-upgrade-center-app/pages/upgrade-popup",
			"style": {
				"disableScroll": true,
				"app-plus": {
					"backgroundColorTop": "transparent",
					"background": "transparent",
					"titleNView": false,
					"scrollIndicator": false,
					"popGesture": "none",
					"animationType": "fade-in",
					"animationDuration": 200

				}
			}
		},
		// #endif
		{
			"path": "pages/tabbars/note/note",
			"style": {
				"navigationBarTitleText": "",
				"navigationStyle": "custom"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages/notes",
			"pages": [
				{
					"path": "noteSquare/noteSquare",
					"style": {
						"navigationBarTitleText": "小记广场"
					}
				},
				{
					"path": "noteView/noteView",
					"style": {
						"navigationBarTitleText": ""
					}
				}
			]
		},
		{
			"root": "uni_modules/uni-feedback/pages",
			"pages": [{
				"path": "opendb-feedback/opendb-feedback",
				"style": {
					"navigationBarTitleText": "意见反馈",
					"enablePullDownRefresh": false
				}
			}]
		},
		{
			"root": "pages/mine",
			"pages": [
				{
					"path": "myLikes/myLikes",
					"style": {
						"navigationBarTitleText": "我喜欢的",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "myCollect/myCollect",
					"style": {
						"navigationBarTitleText": "我的收藏",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "readLog/readLog",
					"style": {
						"navigationBarTitleText": "阅读记录",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "settings/settings",
					"style": {
						"navigationBarTitleText": "个人设置"
					}
				},
				{
					"path": "about/about",
					"style": {
						"navigationBarTitleText": "关于"
					}
				}
			]
		},
		{
			"root": "pages/myWorks",
			"pages": [
				{
					"path": "myWorks",
					"style": {
						"navigationBarTitleText": "我的文章",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "detail/detail",
					"style": {
						"navigationBarTitleText": "文章详情"
					}
				},
				{
					"path": "add/add",
					"style": {
						"navigationBarTitleText": "新建文章"
					}
				}
			]
		},
		{
			"root": "pages/myVideo",
			"pages": [
				{
					"path": "myVideo",
					"style": {
						"navigationBarTitleText": "我的视频",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "add/add",
					"style": {
						"navigationBarTitleText": "新建视频"
					}
				},
				{
					"path": "preView/preView",
					"style": {
						"navigationBarTitleText": ""
					}
				}
			]
		},
		{
			"root": "pages/myNotes",
			"pages": [
				{
					"path": "myNotes",
					"style": {
						"navigationBarTitleText": "我的小记",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "add/add",
					"style": {
						"navigationBarTitleText": "新增小记"
					}
				}
			]
		},
		{
			"root": "uni_modules/uni-id-pages/pages",
			"pages": [
				{
					"path": "login/login-withpwd",
					"style": {
						"navigationBarTitleText": "账号密码登录"
					}
				},
				{
					"path": "userinfo/userinfo",
					"style": {
						"navigationBarTitleText": "个人资料"
					}
				},
				{
					"path": "login/login-smscode",
					"style": {
						"navigationBarTitleText": "手机验证码登录"
					}
				},
				{
					"path": "register/register",
					"style": {
						"navigationBarTitleText": "注册"
					}
				},
				{
					"path": "login/login-withoutpwd",
					"style": {
						"navigationBarTitleText": "登录"
					}
				},
				{
					"path": "userinfo/bind-mobile/bind-mobile",
					"style": {
						"navigationBarTitleText": "绑定手机号码"
					}
				},
				{
					"path": "userinfo/cropImage/cropImage",
					"style": {
						"navigationBarTitleText": ""
					}
				},
				{
					"path": "register/register-by-email",
					"style": {
						"navigationBarTitleText": "邮箱验证码注册"
					}
				},
				{
					"path": "retrieve/retrieve",
					"style": {
						"navigationBarTitleText": "重置密码"
					}
				},
				{
					"path": "retrieve/retrieve-by-email",
					"style": {
						"navigationBarTitleText": "通过邮箱重置密码"
					}
				},
				{
					"path": "common/webview/webview",
					"style": {
						"enablePullDownRefresh": false,
						"navigationBarTitleText": ""
					}
				},
				{
					"path": "userinfo/change_pwd/change_pwd",
					"style": {
						"enablePullDownRefresh": false,
						"navigationBarTitleText": "修改密码"
					}
				},
				{
					"path": "register/register-admin",
					"style": {
						"enablePullDownRefresh": false,
						"navigationBarTitleText": "注册管理员账号"
					}
				},
				{
					"path": "userinfo/set-pwd/set-pwd",
					"style": {
						"enablePullDownRefresh": false,
						"navigationBarTitleText": "设置密码"
					}
				},
				{
					"path": "userinfo/deactivate/deactivate",
					"style": {
						"navigationBarTitleText": "注销账号"
					}
				},
				{
					"path": "userinfo/realname-verify/realname-verify",
					"style": {
						"enablePullDownRefresh": false,
						"navigationBarTitleText": "实名认证"
					}
				}
			]
		},
		{
			"root": "uni_modules/uni-cms-article/pages",
			"pages": [
				{
					"path": "detail/detail",
					"style": {
						"backgroundColor": "#FFFFFF",
						"navigationBarTitleText": ""
					}
				},
				{
					"path": "detail/preview",
					"style": {
						"backgroundColor": "#FFFFFF",
						"navigationBarTitleText": ""
					}
				},
				{
					"path": "webview/webview",
					"style": {
						"navigationBarTitleText": ""
					}
				},
				{
					"path": "search/search",
					"style": {
						// #ifdef H5
						"navigationStyle": "custom",
						// #endif
						"navigationBarTitleText": "搜索"
					}
				}
			]
		},
		{
			"root": "pages/followers",
			"pages": [
				{
					"path": "followers",
					"style": {
						"navigationBarTitleText": "我关注的"
					}
				}
			]
		}
	],
	"preloadRule": {
		"pages/tabbars/article/list": {
			"network": "all",
			"packages": [
				"uni_modules/uni-cms-article/pages"
			]
		},
		"pages/tabbars/note/note": {
			"network": "all",
			"packages": [
				"pages/notes"
			]
		},
		"pages/tabbars/ucenter/ucenter": {
			"network": "all",
			"packages": [
				"pages/mine",
				"pages/myWorks",
				"pages/myVideo",
				"pages/myNotes",
				"pages/followers",
				"uni_modules/uni-feedback/pages"
			]
		},
		"pages/mine/settings/settings": {
			"network": "all",
			"packages": [
				"uni_modules/uni-id-pages/pages"
			]
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "文影",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8",
		"enablePullDownRefresh": false
	},
	"condition": {
		"list": [{
				"path": "pages/tabbars/article/list"
			}, {
				"path": "uni_modules/uni-cms-article/pages/detail/detail"
			},{
				"path": "pages/notes/noteView/noteView"
			}
		],
		"current": 0
	},
	"tabBar": {
		"color": "#707070",
		"selectedColor": "#1296db",
		"borderStyle": "black",
		"backgroundColor": "#FFFFFF",
		"list": [{
			// #ifndef MP-WEIXIN
			"pagePath": "uni_modules/uni-cms-article/pages/list/list",
			// #endif
			// #ifdef MP-WEIXIN
			"pagePath": "pages/tabbars/article/list",
			// #endif
			"iconPath": "static/tabbar/home.png",
			"selectedIconPath": "static/tabbar/home-active.png",
			"text": "首页"
		}, {
			"pagePath": "pages/tabbars/note/note",
			"iconPath": "static/tabbar/xiaoji.png",
			"selectedIconPath": "/static/tabbar/xiaoji-active.png",
			"text": "小记"
		}, {
			"pagePath": "pages/tabbars/video/video",
			"iconPath": "static/tabbar/media.png",
			"selectedIconPath": "static/tabbar/media-active.png",
			"text": "短视频"
		}, {
			"pagePath": "pages/tabbars/ucenter/ucenter",
			"iconPath": "static/tabbar/me.png",
			"selectedIconPath": "static/tabbar/me-active.png",
			"text": "我的"
		}]
	},
	"uniIdRouter": {
		"loginPage": "uni_modules/uni-id-pages/pages/login/login-withpwd",
		"needLogin": [
			"/uni_modules/uni-id-pages/pages/userinfo/userinfo",
			"/pages/mine/myLikes/myLikes",
			"/pages/mine/myCollect/myCollect",
			"/pages/mine/readLog/readLog",
			"/pages/mine/settings/settings",
			"/pages/myWorks/myWorks",
			"/pages/myNotes/myNotes",
			"/pages/myVideo/myVideo",
			"/pages/myNotes/add/add",
			"/pages/followers/followers"
		],
		"resToLogin": true
	}
}
